# ==============================================================
# CloudVault Server Configuration
# ==============================================================
PORT=3000
JWT_SECRET=cloudvault-super-secret-key-2026
DB_PATH=./database.sqlite
UPLOAD_DIR=./uploads

# ==============================================================
# Cloud Storage Provider Selection: 'local', 's3', or 'gcs'
# ==============================================================
STORAGE_PROVIDER=local

# --------------------------------------------------------------
# AWS S3 / MinIO / Wasabi / Cloudflare R2 Settings
# (Active when STORAGE_PROVIDER=s3)
# --------------------------------------------------------------
AWS_REGION=us-east-1
AWS_S3_BUCKET=cloudvault-storage-bucket
# AWS_ACCESS_KEY_ID=your_aws_access_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret_key
# AWS_S3_ENDPOINT=http://127.0.0.1:9000  # Optional for MinIO / LocalStack

# --------------------------------------------------------------
# Google Cloud Storage (GCS) Settings
# (Active when STORAGE_PROVIDER=gcs)
# --------------------------------------------------------------
GCS_PROJECT_ID=cloudvault-project
GCS_BUCKET_NAME=cloudvault-gcs-bucket
# GCS_KEY_FILE=./gcp-key.json
# GOOGLE_APPLICATION_CREDENTIALS=./gcp-key.json
